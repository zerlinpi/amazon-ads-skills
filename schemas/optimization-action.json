{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zerlinpi/amazon-ads-skills/schemas/optimization-action.json",
  "title": "Amazon Ads Optimization Action Proposal",
  "type": "object",
  "required": ["action_type", "entity_type", "reason", "evidence", "confidence", "mode", "guardrails", "validation_window", "rollback_condition"],
  "properties": {
    "action_type": {"type": "string", "minLength": 1},
    "entity_type": {"type": "string", "minLength": 1},
    "entity_id": {"type": ["string", "null"]},
    "current_value": {},
    "proposed_value": {},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "mode": {"type": "string", "enum": ["Read-only", "Suggest", "Shadow", "Execute"]},
    "guardrails": {"type": "array", "items": {"type": "string"}},
    "validation_window": {"type": "string", "minLength": 1},
    "rollback_condition": {"type": "string", "minLength": 1},
    "priority": {"type": ["string", "null"], "enum": ["critical", "high", "medium", "low", null]},
    "requires_human_review": {"type": "boolean", "default": true}
  },
  "additionalProperties": true
}
