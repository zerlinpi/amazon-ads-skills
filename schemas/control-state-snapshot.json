{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zerlinpi/amazon-ads-skills/schemas/control-state-snapshot.json",
  "title": "Control State Snapshot",
  "description": "Read-only evidence contract for material advertiser controls at a decision-relevant point in time. Missing, unsupported, or unproven coverage remains unknown and must never be coerced to zero or unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "observed_at", "source", "coverage", "controls"],
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marketplace_id", "profile_id"],
      "properties": {
        "marketplace_id": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "campaign_id": {"type": ["string", "null"]},
        "ad_group_id": {"type": ["string", "null"]},
        "entity_id": {"type": ["string", "null"]}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_system", "acquisition_channel"],
      "properties": {
        "source_system": {"type": "string", "minLength": 1},
        "acquisition_channel": {"type": "string", "minLength": 1},
        "connector_id": {"type": ["string", "null"]},
        "readback_id": {"type": ["string", "null"]}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Explicit proof boundary for the material controls expected for this decision. Complete means every required control type is represented in controls with source-supported evidence; absence from controls is never evidence of absence.",
      "required": ["required_control_types", "coverage_status"],
      "properties": {
        "required_control_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/controlType"}
        },
        "coverage_status": {"type": "string", "enum": ["Complete", "Partial", "Unknown"]},
        "evidence_note": {"type": ["string", "null"]}
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_type", "state", "effective_at", "evidence_status"],
        "properties": {
          "control_type": {"$ref": "#/$defs/controlType"},
          "state": {
            "description": "Source-supported configured state. Use null when evidence is missing or unsupported; never synthesize zero/false/unchanged.",
            "type": ["object", "array", "string", "number", "boolean", "null"]
          },
          "effective_at": {"type": ["string", "null"], "format": "date-time"},
          "evidence_status": {"type": "string", "enum": ["observed", "derived", "stale", "unsupported", "unknown"]},
          "evidence_note": {"type": ["string", "null"]}
        }
      }
    }
  },
  "$defs": {
    "controlType": {
      "type": "string",
      "enum": ["base_bid", "bidding_strategy", "placement_adjustment", "audience_bid_adjustment", "schedule_or_event_rule", "budget_or_pacing", "targeting_or_routing", "experiment_assignment", "other_material_control"]
    }
  }
}
