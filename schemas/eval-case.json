{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zerlinpi/amazon-ads-skills/schemas/eval-case.json",
  "title": "Amazon Ads Skill Eval Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "entrypoint", "mode", "scenario", "inputs", "expected"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string", "minLength": 1},
    "mode": {"enum": ["Read-only", "Suggest", "Shadow"]},
    "scenario": {"type": "string", "minLength": 1},
    "inputs": {"type": "object"},
    "allowed_external_evidence": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptable_decisions", "forbidden_behaviors", "rubric"],
      "properties": {
        "acceptable_decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["action_safe", "directional", "blocked", "hold", "experiment_only", "manual_review"]
          }
        },
        "forbidden_behaviors": {
          "type": "array",
          "items": {"type": "string"}
        },
        "required_observations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rubric": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "requirement"],
            "properties": {
              "criterion": {"type": "string", "minLength": 1},
              "requirement": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
