{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zerlinpi/amazon-ads-skills/schemas/optimization-event.json",
  "title": "Amazon Ads Optimization Event",
  "type": "object",
  "additionalProperties": true,
  "required": ["event_id", "event_type", "timestamp", "entity", "action_type"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "parent_action_id": {"type": ["string", "null"]},
    "supersedes_event_id": {"type": ["string", "null"]},
    "event_type": {
      "type": "string",
      "enum": ["proposed", "approved", "applied", "readback", "evaluated", "corrected", "rollback_proposed", "rolled_back", "failed", "unknown"]
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "marketplace": {"type": ["string", "null"]},
    "profile_scope": {"type": ["string", "null"]},
    "entity": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string"},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "action_type": {"type": "string"},
    "before_value": {},
    "intended_value": {},
    "current_value": {},
    "objective": {"type": ["string", "null"]},
    "expected_mechanism": {"type": ["string", "null"]},
    "application_status": {
      "type": ["string", "null"],
      "enum": ["Confirmed", "Partial", "Not Applied", "Drifted", "Unknown", null]
    },
    "outcome_status": {
      "type": ["string", "null"],
      "enum": ["Worked", "Likely Worked", "Monitoring", "Inconclusive", "Likely Failed", "Failed", "Application Failure", "Drifted", null]
    },
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "baseline_window": {"type": ["object", "null"]},
    "post_change_window": {"type": ["object", "null"]},
    "evidence": {"type": "array", "items": {}},
    "evidence_snapshot": {
      "type": ["object", "null"],
      "description": "Decision-time evidence identity for reproducibility when reporting history can restate.",
      "properties": {
        "snapshot_id": {"type": ["string", "null"]},
        "source_dataset": {"type": ["string", "null"]},
        "semantic_version": {"type": ["string", "null"]},
        "captured_at": {"type": ["string", "null"], "format": "date-time"},
        "available_through": {"type": ["string", "null"]},
        "maturity": {"type": ["string", "null"]},
        "evidence_hash": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "restatement": {
      "type": ["object", "null"],
      "properties": {
        "detected_at": {"type": ["string", "null"], "format": "date-time"},
        "reason": {"type": ["string", "null"]},
        "prior_snapshot_id": {"type": ["string", "null"]},
        "replacement_snapshot_id": {"type": ["string", "null"]},
        "material_to_outcome": {"type": ["boolean", "null"]}
      },
      "additionalProperties": true
    },
    "confounders": {"type": "array", "items": {}},
    "decision": {
      "type": ["string", "null"],
      "enum": ["Keep", "Keep Monitoring", "Rollback Candidate", "Follow-up Experiment", "Fix Application", "Manual Review", null]
    },
    "next_evaluation": {"type": ["string", "object", "null"]},
    "rollback_condition": {},
    "source_lineage": {"type": "array", "items": {}},
    "mode": {
      "type": "string",
      "enum": ["Read-only", "Suggest", "Shadow", "Execute"]
    }
  }
}
