{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zerlinpi/amazon-ads-skills/schemas/connector-capability-snapshot.json",
  "title": "Connector Capability Snapshot",
  "description": "Connector-neutral observation of what an active acquisition path can expose. This contract describes capability evidence; it never converts unsupported or missing data into metric zero and never grants mutation authority.",
  "type": "object",
  "required": ["connector_id", "captured_at", "default_access_mode", "capabilities"],
  "properties": {
    "connector_id": {"type": "string", "minLength": 1},
    "connector_version": {"type": ["string", "null"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "source_system": {"type": ["string", "null"]},
    "acquisition_channel": {"type": ["string", "null"]},
    "default_access_mode": {
      "type": "string",
      "enum": ["Read-only", "Read/Write", "Unknown"]
    },
    "catalog_discovery": {
      "type": ["object", "null"],
      "properties": {
        "mode": {"type": ["string", "null"], "enum": ["bounded", "progressive", "full", "unknown", null]},
        "tool_count": {"type": ["integer", "null"], "minimum": 0},
        "namespaces": {"type": "array", "items": {"type": "string"}},
        "server_instructions_exposed": {"type": ["boolean", "null"]}
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "status", "access_mode"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["Supported", "Partial", "Unsupported", "Unknown"]
          },
          "access_mode": {
            "type": "string",
            "enum": ["read", "report", "export", "stream", "write", "mixed", "unknown"]
          },
          "source_system": {"type": ["string", "null"]},
          "acquisition_channel": {"type": ["string", "null"]},
          "scope": {
            "type": ["object", "null"],
            "properties": {
              "regions": {"type": "array", "items": {"type": "string"}},
              "marketplaces": {"type": "array", "items": {"type": "string"}},
              "ad_products": {"type": "array", "items": {"type": "string"}},
              "account_types": {"type": "array", "items": {"type": "string"}},
              "identity_fields_exposed": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          },
          "data_contract": {
            "type": ["object", "null"],
            "properties": {
              "reporting_generation": {"type": ["string", "null"]},
              "report_lifecycle": {
                "type": ["string", "null"],
                "enum": ["synchronous", "asynchronous", "push", "export", "unknown", null]
              },
              "pagination": {
                "type": ["string", "null"],
                "enum": ["none", "next_token", "cursor", "page", "opaque", "unknown", null]
              },
              "truncation_signal_exposed": {"type": ["boolean", "null"]},
              "row_eligibility_exposed": {"type": ["boolean", "null"]},
              "historical_availability_exposed": {"type": ["boolean", "null"]},
              "freshness_exposed": {"type": ["boolean", "null"]},
              "available_through_exposed": {"type": ["boolean", "null"]},
              "metric_semantics_exposed": {"type": ["boolean", "null"]},
              "date_attribution_semantics_exposed": {"type": ["boolean", "null"]},
              "maximum_history_window": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          },
          "tool_annotations": {
            "type": ["object", "null"],
            "description": "MCP risk hints as observed from a tool surface. These values are advisory metadata, not authorization or enforcement.",
            "properties": {
              "readOnlyHint": {"type": ["boolean", "null"]},
              "destructiveHint": {"type": ["boolean", "null"]},
              "idempotentHint": {"type": ["boolean", "null"]},
              "openWorldHint": {"type": ["boolean", "null"]},
              "trust_status": {
                "type": ["string", "null"],
                "enum": ["Verified", "Unverified", "Unknown", null]
              }
            },
            "additionalProperties": true
          },
          "error_contract": {
            "type": ["object", "null"],
            "properties": {
              "structured_errors": {"type": ["boolean", "null"]},
              "unsupported_distinct_from_empty": {"type": ["boolean", "null"]},
              "unauthorized_distinct_from_unsupported": {"type": ["boolean", "null"]},
              "retryability_exposed": {"type": ["boolean", "null"]},
              "corrective_hints_exposed": {"type": ["boolean", "null"]}
            },
            "additionalProperties": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {"type": ["string", "null"]},
                "reference": {"type": ["string", "null"]},
                "observed_at": {"type": ["string", "null"], "format": "date-time"},
                "notes": {"type": ["string", "null"]}
              },
              "additionalProperties": true
            }
          },
          "warnings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
